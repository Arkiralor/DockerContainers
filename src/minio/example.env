# libreFS (S3-compatible object storage) configuration
# Copy this file to .env and adjust values as needed.

# Root credentials for the libreFS admin user.
# These also serve as the S3 access key and secret key.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Ports
# S3 API port (used by applications to interact with the storage)
LIBREFS_API_PORT=9000
# Web console port (browser-based admin UI for bucket management)
LIBREFS_CONSOLE_PORT=9001
